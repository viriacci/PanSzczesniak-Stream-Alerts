{
  "name": "pssa-v2",
  "productName": "PSSA",
  "version": "2.0.0-rc.10",
  "private": true,
  "description": "Local Twitch streaming control center",
  "author": "PanSzczesniak",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "smoke": "electron . --smoke-test",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/installer-assets.ps1 && npm run build && electron-builder --win nsis --x64 --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-setup.ps1"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "sass": "1.93.3",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  }
}
