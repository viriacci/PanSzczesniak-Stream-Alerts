{
  "name": "pssa-v2",
  "productName": "PSSA 2 Dev",
  "version": "2.0.0-dev.4",
  "private": true,
  "description": "Local Twitch streaming control center",
  "author": "PanSzczesniak",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "smoke": "electron . --smoke-test",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "45.4.1",
    "electron-builder": "26.12.1",
    "electron-vite": "5.0.0",
    "sass": "1.93.3",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
